---
import BaseLayout from './BaseLayout.astro';
import { DOCS_NAV } from '../data/horos';
import { withBase } from '../utils/url';
import { ChevronRight, ArrowLeft, ArrowRight, BookOpen } from '@lucide/astro';

export interface TocHeading {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  currentSlug: string;
  headings?: TocHeading[];
}

const { title, description, currentSlug, headings = [] } = Astro.props;

const currentIndex = DOCS_NAV.findIndex((item) => item.slug === currentSlug);
const prevDoc = currentIndex > 0 ? DOCS_NAV[currentIndex - 1] : null;
const nextDoc = currentIndex >= 0 && currentIndex < DOCS_NAV.length - 1 ? DOCS_NAV[currentIndex + 1] : null;
---

<BaseLayout title={`${title} | HOROS Docs`} description={description} ogType="article">
  <div class="border-b border-slate-200/80 bg-slate-50/70 dark:border-slate-800/80 dark:bg-slate-900/40">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">
        <a href={withBase('/')} class="hover:text-sky-600 dark:hover:text-sky-400">HOROS</a>
        <ChevronRight class="h-3.5 w-3.5" />
        <a href={withBase('/docs')} class="hover:text-sky-600 dark:hover:text-sky-400">Docs</a>
        {
          currentSlug !== '/docs' && (
            <>
              <ChevronRight class="h-3.5 w-3.5" />
              <span class="text-slate-900 dark:text-slate-100">{title}</span>
            </>
          )
        }
      </nav>
      <span class="hidden text-xs font-mono text-slate-500 sm:inline dark:text-slate-400">
        ROS 2 Humble · C++ / Python
      </span>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[240px_minmax(0,1fr)] xl:grid-cols-[240px_minmax(0,1fr)_210px]">
      <!-- Sidebar -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="mb-3 flex items-center gap-2 text-xs font-bold tracking-wider text-slate-900 uppercase dark:text-slate-100">
            <BookOpen class="h-3.5 w-3.5 text-sky-500" />
            Documentation
          </div>
          <nav aria-label="Documentation Sidebar" class="space-y-1">
            {
              DOCS_NAV.map((item) => {
                const active = item.slug === currentSlug;
                return (
                  <a
                    href={withBase(item.slug)}
                    class:list={[
                      'block rounded-lg px-3 py-2 text-sm transition-colors',
                      active
                        ? 'bg-sky-500/15 font-semibold text-sky-700 dark:bg-sky-400/15 dark:text-sky-300'
                        : 'text-slate-600 hover:bg-slate-200/60 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100',
                    ]}
                  >
                    {item.title}
                  </a>
                );
              })
            }
          </nav>
        </div>
      </aside>

      <!-- Main Docs Article -->
      <article class="min-w-0">
        <header class="mb-8 border-b border-slate-200 pb-6 dark:border-slate-800">
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
            {title}
          </h1>
          <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-300">
            {description}
          </p>
        </header>

        <div class="space-y-10">
          <slot />
        </div>

        <!-- Prev / Next Navigation -->
        <div class="mt-14 grid gap-4 border-t border-slate-200 pt-8 sm:grid-cols-2 dark:border-slate-800">
          {
            prevDoc ? (
              <a
                href={withBase(prevDoc.slug)}
                class="group flex flex-col rounded-xl border border-slate-200 p-4 transition hover:border-sky-500/50 hover:bg-slate-50 dark:border-slate-800 dark:hover:border-sky-400/50 dark:hover:bg-slate-900/60"
              >
                <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-500 dark:text-slate-400">
                  <ArrowLeft class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" />
                  Previous
                </span>
                <span class="mt-1 font-semibold text-slate-900 group-hover:text-sky-600 dark:text-white dark:group-hover:text-sky-400">
                  {prevDoc.title}
                </span>
              </a>
            ) : (
              <div />
            )
          }

          {
            nextDoc && (
              <a
                href={withBase(nextDoc.slug)}
                class="group flex flex-col items-end rounded-xl border border-slate-200 p-4 text-right transition hover:border-sky-500/50 hover:bg-slate-50 dark:border-slate-800 dark:hover:border-sky-400/50 dark:hover:bg-slate-900/60"
              >
                <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-500 dark:text-slate-400">
                  Next
                  <ArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
                </span>
                <span class="mt-1 font-semibold text-slate-900 group-hover:text-sky-600 dark:text-white dark:group-hover:text-sky-400">
                  {nextDoc.title}
                </span>
              </a>
            )
          }
        </div>
      </article>

      <!-- Right TOC -->
      {
        headings.length > 0 && (
          <aside class="hidden xl:sticky xl:top-24 xl:block xl:self-start">
            <div class="border-l border-slate-200 pl-4 dark:border-slate-800">
              <p class="text-xs font-bold tracking-wider text-slate-900 uppercase dark:text-slate-100">
                On this page
              </p>
              <ul class="mt-3 space-y-2 text-xs">
                {headings.map((h) => (
                  <li>
                    <a
                      href={`#${h.id}`}
                      class="block text-slate-500 transition hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400"
                    >
                      {h.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>
