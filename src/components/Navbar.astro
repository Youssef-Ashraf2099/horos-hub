---
import { withBase } from '../utils/url';
import { SITE_META } from '../data/horos';
import { Sun, Moon, Menu, X } from '@lucide/astro';
import GitHubIcon from './GitHubIcon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { label: 'Overview', href: withBase('/'), match: '/' },
  { label: 'Architecture', href: withBase('/docs/architecture'), match: '/docs/architecture' },
  { label: 'Threat Vectors', href: withBase('/docs/threat-vectors'), match: '/docs/threat-vectors' },
  { label: 'Benchmarks', href: withBase('/docs/benchmarks'), match: '/docs/benchmarks' },
  { label: 'Quickstart', href: withBase('/docs/quickstart'), match: '/docs/quickstart' },
  { label: 'Docs', href: withBase('/docs'), match: '/docs' },
];

function isActive(match: string): boolean {
  const clean = currentPath.replace(import.meta.env.BASE_URL.replace(/\/+$/, ''), '') || '/';
  if (match === '/') return clean === '/' || clean === '';
  return clean === match || (match === '/docs' && clean === '/docs/');
}
---

<header
  class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/85 backdrop-blur-md transition-colors dark:border-slate-800/80 dark:bg-slate-950/85"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand -->
    <a href={withBase('/')} class="group flex items-center gap-3">
      <div
        class="relative flex h-9 w-9 items-center justify-center overflow-hidden rounded-lg border border-sky-500/30 bg-slate-50 p-0.5 shadow-sm ring-1 ring-slate-900/5 transition group-hover:scale-105 dark:border-sky-400/30 dark:bg-slate-900/90"
      >
        <img
          src={withBase('/images/horos-emblem.png')}
          alt="HOROS Framework Emblem"
          class="h-full w-full object-contain object-center drop-shadow-xs"
          width="36"
          height="36"
        />
      </div>
      <div class="flex flex-col leading-none">
        <div class="flex items-center gap-2">
          <span class="text-base font-bold tracking-tight text-slate-900 dark:text-white">HOROS</span>
          <span
            class="hidden rounded-full border border-sky-500/30 bg-sky-500/10 px-2 py-0.5 text-[10px] font-semibold tracking-wide text-sky-700 uppercase sm:inline-block dark:text-sky-300"
          >
            {SITE_META.version} · {SITE_META.codename}
          </span>
        </div>
        <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">
          Robot Cyber-Resilience
        </span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav aria-label="Primary Navigation" class="hidden items-center gap-1 md:flex">
      {
        navLinks.map((link) => {
          const active = isActive(link.match);
          return (
            <a
              href={link.href}
              class:list={[
                'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
                active
                  ? 'bg-sky-500/10 text-sky-700 dark:bg-sky-400/15 dark:text-sky-300'
                  : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800/80 dark:hover:text-white',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <a
        href={SITE_META.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-sky-500/50 hover:text-sky-700 sm:inline-flex dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-sky-400/50 dark:hover:text-sky-300"
        title="View horos_framework on GitHub"
      >
        <GitHubIcon class="h-3.5 w-3.5" />
        <span>horos_framework</span>
      </a>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark and light theme"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 transition hover:border-sky-500/50 hover:text-sky-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-sky-400/50 dark:hover:text-sky-300"
      >
        <Sun class="hidden h-4 w-4 dark:block" />
        <Moon class="block h-4 w-4 dark:hidden" />
      </button>

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 transition hover:bg-slate-100 md:hidden dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        <Menu id="mobile-icon-open" class="h-4 w-4" />
        <X id="mobile-icon-close" class="hidden h-4 w-4" />
      </button>
    </div>
  </div>

  <!-- Mobile Nav Drawer -->
  <div
    id="mobile-nav-drawer"
    class="hidden border-t border-slate-200 bg-white px-4 py-3 md:hidden dark:border-slate-800 dark:bg-slate-950"
  >
    <nav class="flex flex-col gap-1">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={SITE_META.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white dark:bg-sky-600"
      >
        <GitHubIcon class="h-4 w-4" />
        <span>GitHub: horos_framework</span>
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const themeBtn = document.getElementById('theme-toggle');
    themeBtn?.addEventListener('click', () => {
      const root = document.documentElement;
      const isDark = root.classList.toggle('dark');
      localStorage.setItem('horos-theme', isDark ? 'dark' : 'light');
    });

    const menuBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    const iconOpen = document.getElementById('mobile-icon-open');
    const iconClose = document.getElementById('mobile-icon-close');

    menuBtn?.addEventListener('click', () => {
      const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!expanded));
      drawer?.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
    });
  })();
</script>
