---
import { THREAT_VECTORS } from '../data/horos';
import { ShieldAlert, CircleCheck, Search } from '@lucide/astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class="space-y-6">
  <!-- Filter Bar -->
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filter Threat Vectors by Tier">
      <button
        type="button"
        data-tier="ALL"
        class="tier-filter-btn rounded-lg border border-sky-500 bg-sky-500/15 px-3 py-1.5 text-xs font-semibold text-sky-700 transition dark:text-sky-300"
      >
        All Vectors (13)
      </button>
      <button
        type="button"
        data-tier="I"
        class="tier-filter-btn rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-sky-500/50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
      >
        Tier I · Classic (6)
      </button>
      <button
        type="button"
        data-tier="II"
        class="tier-filter-btn rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-sky-500/50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
      >
        Tier II · Barrier &amp; Sensory (3)
      </button>
      <button
        type="button"
        data-tier="III"
        class="tier-filter-btn rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-sky-500/50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
      >
        Tier III · Adaptive &amp; Postural (4)
      </button>
    </div>

    <div class="relative w-full sm:w-64">
      <Search class="pointer-events-none absolute top-1/2 left-3 h-3.5 w-3.5 -translate-y-1/2 text-slate-400" />
      <input
        id="threat-search-input"
        type="search"
        placeholder="Filter e.g. V10, LiDAR, ZMP..."
        class="w-full rounded-lg border border-slate-200 bg-white py-1.5 pr-3 pl-8 text-xs text-slate-800 placeholder:text-slate-400 focus:border-sky-500 focus:outline-none dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
      />
    </div>
  </div>

  <!-- Threat Cards Grid -->
  <div id="threat-cards-grid" class:list={['grid gap-4', compact ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2']}>
    {
      THREAT_VECTORS.map((tv) => {
        const tierBadgeClass =
          tv.tier === 'I'
            ? 'border-sky-500/30 bg-sky-500/10 text-sky-700 dark:text-sky-300'
            : tv.tier === 'II'
              ? 'border-amber-500/30 bg-amber-500/10 text-amber-700 dark:text-amber-300'
              : 'border-rose-500/30 bg-rose-500/10 text-rose-700 dark:text-rose-300';

        return (
          <article
            data-threat-tier={tv.tier}
            data-threat-text={`${tv.code} ${tv.title} ${tv.mitreTag} ${tv.attackMechanism} ${tv.horosDefense}`.toLowerCase()}
            class="threat-card flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4 shadow-xs transition hover:border-sky-500/50 dark:border-slate-800 dark:bg-slate-900/75"
          >
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <span class="rounded-md bg-slate-900 px-2 py-0.5 font-mono text-xs font-bold text-white dark:bg-slate-800 dark:text-sky-300">
                    {tv.code}
                  </span>
                  <span class={`rounded-full border px-2 py-0.5 text-[10px] font-semibold ${tierBadgeClass}`}>
                    Tier {tv.tier}
                  </span>
                </div>
                <span class="font-mono text-[10px] text-slate-500 dark:text-slate-400">{tv.mitreTag}</span>
              </div>

              <h3 class="mt-2.5 text-sm font-bold text-slate-900 dark:text-white">{tv.title}</h3>

              <p class="mt-2 flex items-start gap-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
                <ShieldAlert class="mt-0.5 h-3.5 w-3.5 shrink-0 text-rose-500" />
                <span>{tv.attackMechanism}</span>
              </p>
            </div>

            <div class="mt-3 border-t border-slate-100 pt-3 dark:border-slate-800/80">
              <p class="flex items-start gap-1.5 text-xs leading-relaxed text-slate-700 dark:text-slate-300">
                <CircleCheck class="mt-0.5 h-3.5 w-3.5 shrink-0 text-emerald-500" />
                <span>{tv.horosDefense}</span>
              </p>
              <div class="mt-2 flex items-center justify-between text-[11px]">
                <span class="font-mono text-emerald-700 dark:text-emerald-400">{tv.metricImpact}</span>
                <span class="font-semibold text-slate-500 dark:text-slate-400">{tv.severity}</span>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>

  <p id="threat-empty-msg" class="hidden rounded-xl border border-slate-200 p-6 text-center text-sm text-slate-500 dark:border-slate-800 dark:text-slate-400">
    No threat vectors match that filter.
  </p>
</div>

<script is:inline>
  (() => {
    let activeTier = 'ALL';
    const buttons = document.querySelectorAll('.tier-filter-btn');
    const searchInput = document.getElementById('threat-search-input');
    const cards = document.querySelectorAll('.threat-card');
    const emptyMsg = document.getElementById('threat-empty-msg');

    function filterCards() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const tier = card.getAttribute('data-threat-tier');
        const text = card.getAttribute('data-threat-text') || '';
        const tierOk = activeTier === 'ALL' || tier === activeTier;
        const textOk = !q || text.includes(q);
        const show = tierOk && textOk;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      emptyMsg?.classList.toggle('hidden', visible > 0);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTier = btn.getAttribute('data-tier') || 'ALL';
        buttons.forEach((b) => {
          b.classList.remove('border-sky-500', 'bg-sky-500/15', 'text-sky-700', 'dark:text-sky-300');
          b.classList.add('border-slate-200', 'bg-white', 'text-slate-600', 'dark:border-slate-800', 'dark:bg-slate-900', 'dark:text-slate-300');
        });
        btn.classList.add('border-sky-500', 'bg-sky-500/15', 'text-sky-700', 'dark:text-sky-300');
        btn.classList.remove('border-slate-200', 'bg-white', 'text-slate-600', 'dark:border-slate-800', 'dark:bg-slate-900', 'dark:text-slate-300');
        filterCards();
      });
    });

    searchInput?.addEventListener('input', filterCards);
  })();
</script>
