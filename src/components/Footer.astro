---
import { withBase } from '../utils/url';
import { SITE_META, DOCS_NAV } from '../data/horos';
import { Shield, BookOpen, GraduationCap, Globe } from '@lucide/astro';
import GitHubIcon from './GitHubIcon.astro';
import LinkedInIcon from './LinkedInIcon.astro';
---

<footer class="border-t border-slate-200 bg-slate-50/80 dark:border-slate-800/80 dark:bg-slate-950/90">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-lg border border-sky-500/30 bg-slate-50 p-0.5 dark:bg-slate-900">
            <img
              src={withBase('/images/horos-emblem.png')}
              alt="HOROS Emblem"
              class="h-full w-full object-contain"
              width="40"
              height="40"
            />
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">
              HOROS Framework <span class="text-xs font-normal text-sky-600 dark:text-sky-400">({SITE_META.version} · {SITE_META.codename})</span>
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-400">{SITE_META.tagline}</p>
          </div>
        </div>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          Originally conceived and engineered as a Bachelor of Science thesis in Computer Science at the{' '}
          <strong class="font-semibold text-slate-800 dark:text-slate-200">{SITE_META.institution}</strong> under the
          supervision of {SITE_META.supervisors.join(' & ')}.
        </p>
        <p class="mt-3 text-xs text-slate-500 dark:text-slate-500">
          Copyright © 2026–present {SITE_META.authorName}. Released under the Apache License 2.0. All intellectual
          property and architectural contributions are solely owned by the author.
        </p>
      </div>

      <div>
        <h4 class="flex items-center gap-1.5 text-xs font-semibold tracking-wider text-slate-900 uppercase dark:text-slate-100">
          <BookOpen class="h-3.5 w-3.5 text-sky-500" />
          Documentation
        </h4>
        <ul class="mt-3 space-y-2 text-sm">
          {
            DOCS_NAV.map((item) => (
              <li>
                <a
                  href={withBase(item.slug)}
                  class="text-slate-600 transition hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400"
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="flex items-center gap-1.5 text-xs font-semibold tracking-wider text-slate-900 uppercase dark:text-slate-100">
          <GraduationCap class="h-3.5 w-3.5 text-amber-500" />
          Project & Author
        </h4>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a
              href={SITE_META.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-slate-600 transition hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400"
            >
              <GitHubIcon class="h-3.5 w-3.5" />
              horos_framework Repo
            </a>
          </li>
          <li>
            <a
              href={SITE_META.releasesUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-600 transition hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400"
            >
              Releases ({SITE_META.version})
            </a>
          </li>
          <li>
            <a
              href={SITE_META.authorPortfolio}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-slate-600 transition hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400"
            >
              <Globe class="h-3.5 w-3.5" />
              Creator Portfolio
            </a>
          </li>
          <li>
            <a
              href={SITE_META.authorLinkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-slate-600 transition hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400"
            >
              <LinkedInIcon class="h-3.5 w-3.5" />
              LinkedIn Profile
            </a>
          </li>
          <li>
            <a
              href={SITE_META.authorGithub}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-slate-600 transition hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400"
            >
              <GitHubIcon class="h-3.5 w-3.5" />
              @Youssef-Ashraf2099
            </a>
          </li>
          <li>
            <a
              href={`${SITE_META.repoUrl}/blob/main/LICENSE`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-slate-600 transition hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400"
            >
              <Shield class="h-3.5 w-3.5" />
              Apache-2.0 License
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
