---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { DOCS_NAV, KEY_HIGHLIGHTS, SITE_META } from '../../data/horos';
import { withBase } from '../../utils/url';
import { ArrowRight, Layers, ShieldAlert, ChartColumn, Terminal } from '@lucide/astro';

const headings = [
  { id: 'overview', label: 'Framework Scope' },
  { id: 'modules', label: 'Documentation Sections' },
  { id: 'highlights', label: 'Performance Guarantees' },
];
---

<DocsLayout
  title="HOROS Documentation"
  description="Technical documentation for HOROS (v1.1.1.1 Anubis): Dual-domain ROS 2 cyber-resilience architecture, 13 adversarial threat vectors, empirical hardware benchmarks, and quickstart guides."
  currentSlug="/docs"
  headings={headings}
>
  <section id="overview" class="space-y-4">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Framework Scope</h2>
    <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">
      <strong>HOROS</strong> is an open-source autonomous robot cyber-resilience framework built on{' '}
      <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs dark:bg-slate-800">ROS 2 Humble</code>,{' '}
      <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs dark:bg-slate-800">C++</code>, and{' '}
      <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs dark:bg-slate-800">Python</code>. Rather than treating cybersecurity and physical safety as isolated silos, HOROS acts as a real-time co-pilot gateway between upstream navigation planners (<code class="font-mono text-xs">/cmd_vel</code>) and motor actuators—blending multi-vector cyber threat telemetry with live 360° sensor clearance and IMU posture feedback.
    </p>
    <div class="rounded-xl border border-sky-500/25 bg-sky-500/5 p-4 text-xs leading-relaxed text-slate-700 dark:text-slate-300">
      <strong>Repository:</strong>{' '}
      <a href={SITE_META.repoUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-sky-600 underline dark:text-sky-400">
        github.com/Youssef-Ashraf2099/horos_framework
      </a>{' '}
      · <strong>Release:</strong> {SITE_META.version} ({SITE_META.codename}) · <strong>Target OS:</strong> Ubuntu 22.04 LTS
    </div>
  </section>

  <section id="modules" class="space-y-4">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Documentation Sections</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        DOCS_NAV.filter((d) => d.slug !== '/docs').map((doc, idx) => (
          <a
            href={withBase(doc.slug)}
            class="group flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 transition hover:border-sky-500/60 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900/75"
          >
            <div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs font-bold text-sky-600 dark:text-sky-400">0{idx + 1}</span>
                {idx === 0 ? (
                  <Layers class="h-4 w-4 text-sky-500" />
                ) : idx === 1 ? (
                  <ShieldAlert class="h-4 w-4 text-rose-500" />
                ) : idx === 2 ? (
                  <ChartColumn class="h-4 w-4 text-emerald-500" />
                ) : (
                  <Terminal class="h-4 w-4 text-amber-500" />
                )}
              </div>
              <h3 class="mt-3 text-base font-bold text-slate-900 group-hover:text-sky-600 dark:text-white dark:group-hover:text-sky-400">
                {doc.title}
              </h3>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">{doc.summary}</p>
            </div>
            <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-sky-600 dark:text-sky-400">
              Read section <ArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section id="highlights" class="space-y-4">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Performance Guarantees</h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        KEY_HIGHLIGHTS.map((h) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-900/60">
            <p class="font-mono text-xl font-extrabold text-sky-600 dark:text-sky-400">{h.metric}</p>
            <h3 class="mt-1 text-sm font-bold text-slate-900 dark:text-white">{h.title}</h3>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">{h.detail}</p>
          </div>
        ))
      }
    </div>
  </section>
</DocsLayout>
